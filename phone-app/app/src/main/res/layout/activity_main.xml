<?xml version="1.0" encoding="utf-8"?>
<!-- Framework widgets only (no AppCompat / Material): a small, fast APK.
     Laid out like a piece of studio hardware: a tally light, the level ring
     (which is the Start/Stop key), readouts, keys, then routing and faceplate. -->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?attr/pmBg"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingHorizontal="16dp"
        android:paddingVertical="20dp">

        <!-- Header: badge, wordmark, tally light -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:layout_marginBottom="16dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:layout_width="34dp"
                android:layout_height="34dp"
                android:background="@drawable/bg_badge"
                android:contentDescription="@null"
                android:padding="7dp"
                android:src="@drawable/ic_mic"
                android:tint="?attr/pmOnAccent" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="sans-serif-black"
                    android:letterSpacing="0.2"
                    android:text="@string/wordmark"
                    android:textColor="?attr/pmText"
                    android:textSize="19sp" />

                <TextView
                    android:id="@+id/versionText"
                    style="@style/Label"
                    android:layout_marginTop="1dp" />
            </LinearLayout>

            <TextView
                android:id="@+id/tally"
                android:layout_width="wrap_content"
                android:layout_height="26dp"
                android:background="@drawable/bg_tally"
                android:fontFamily="monospace"
                android:gravity="center"
                android:letterSpacing="0.2"
                android:paddingHorizontal="12dp"
                android:text="@string/tally_standby"
                android:textColor="?attr/pmMuted"
                android:textSize="11sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- Monitor: the ring, status, readouts -->
        <LinearLayout style="@style/Card">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    style="@style/Label"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:text="@string/monitor_label" />

                <View
                    android:id="@+id/statusDot"
                    android:layout_width="7dp"
                    android:layout_height="7dp"
                    android:layout_marginEnd="7dp"
                    android:background="@drawable/dot"
                    android:backgroundTint="?attr/pmLedOff" />

                <TextView
                    android:id="@+id/signalLabel"
                    style="@style/Label"
                    android:text="@string/no_signal" />
            </LinearLayout>

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginHorizontal="-20dp"
                android:layout_marginTop="10dp"
                android:background="?attr/pmEdge" />

            <com.phonemic.LevelRing
                android:id="@+id/levelRing"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:background="@null"
                android:clickable="true"
                android:contentDescription="@string/start"
                android:focusable="true" />

            <TextView
                android:id="@+id/statusText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:gravity="center"
                android:minLines="2"
                android:text="@string/status_idle"
                android:textColor="?attr/pmMuted"
                android:textSize="13sp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/readCodec"
                    style="@style/Readout" />

                <TextView
                    android:id="@+id/readSent"
                    style="@style/Readout"
                    android:layout_marginStart="6dp" />

                <TextView
                    android:id="@+id/readLoss"
                    style="@style/Readout"
                    android:layout_marginStart="6dp" />

                <TextView
                    android:id="@+id/readBuffer"
                    style="@style/Readout"
                    android:layout_marginStart="6dp" />
            </LinearLayout>
        </LinearLayout>

        <!-- Keys: mic mute, Voice Focus, soundboard -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:orientation="horizontal">

            <Button
                android:id="@+id/muteButton"
                style="@style/Key"
                android:layout_height="56dp"
                android:text="@string/key_mic" />

            <Button
                android:id="@+id/voiceFocusKey"
                style="@style/Key"
                android:layout_height="56dp"
                android:layout_marginHorizontal="8dp"
                android:text="@string/key_voice" />

            <Button
                android:id="@+id/soundboardButton"
                style="@style/Key"
                android:layout_height="56dp"
                android:text="@string/key_sfx" />
        </LinearLayout>

        <TextView
            android:id="@+id/keysHint"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:gravity="center"
            android:text="@string/voice_focus_desc"
            android:textColor="?attr/pmMuted"
            android:textSize="11sp" />

        <!-- Routing: link + PC + PIN -->
        <LinearLayout
            style="@style/Card"
            android:layout_marginTop="12dp">

            <TextView
                style="@style/Label"
                android:text="@string/routing_label" />

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginHorizontal="-20dp"
                android:layout_marginTop="10dp"
                android:background="?attr/pmEdge" />

            <LinearLayout
                android:id="@+id/linkRow"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:orientation="horizontal">

                <Button
                    android:id="@+id/linkBluetooth"
                    style="@style/Segment"
                    android:text="@string/link_bluetooth" />

                <Button
                    android:id="@+id/linkWifi"
                    style="@style/Segment"
                    android:layout_marginHorizontal="6dp"
                    android:text="@string/link_wifi" />

                <Button
                    android:id="@+id/linkUsb"
                    style="@style/Segment"
                    android:text="@string/link_usb" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/pcRow"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:background="@drawable/bg_readout"
                android:foreground="?android:attr/selectableItemBackground"
                android:gravity="center_vertical"
                android:minHeight="56dp"
                android:orientation="horizontal"
                android:paddingHorizontal="12dp"
                android:paddingVertical="8dp">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        style="@style/Label"
                        android:text="@string/pc_label" />

                    <TextView
                        android:id="@+id/pcName"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:ellipsize="end"
                        android:fontFamily="monospace"
                        android:maxLines="1"
                        android:text="@string/choose_pc"
                        android:textColor="?attr/pmText"
                        android:textSize="16sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/pcHint"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/pc_hint_choose"
                        android:textColor="?attr/pmMuted"
                        android:textSize="11sp" />
                </LinearLayout>

                <ImageView
                    android:id="@+id/pcChevron"
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    android:contentDescription="@string/choose_pc"
                    android:src="@drawable/ic_chevron"
                    android:tint="?attr/pmMuted" />
            </LinearLayout>

            <!-- Wi-Fi only: the PIN set in PhoneMic on the PC (if any). -->
            <LinearLayout
                android:id="@+id/pinRow"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:background="@drawable/bg_readout"
                android:foreground="?android:attr/selectableItemBackground"
                android:gravity="center_vertical"
                android:minHeight="44dp"
                android:orientation="horizontal"
                android:paddingHorizontal="12dp"
                android:visibility="gone">

                <TextView
                    style="@style/Label"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:text="@string/pin_label" />

                <TextView
                    android:id="@+id/pinValue"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="monospace"
                    android:text="@string/pin_none"
                    android:textColor="?attr/pmText"
                    android:textSize="13sp" />
            </LinearLayout>
        </LinearLayout>

        <!-- Faceplate: theme + accent, same choices as the desktop app -->
        <LinearLayout
            style="@style/Card"
            android:layout_marginTop="12dp">

            <TextView
                style="@style/Label"
                android:text="@string/appearance_label" />

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginHorizontal="-20dp"
                android:layout_marginTop="10dp"
                android:background="?attr/pmEdge" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:orientation="horizontal">

                <Button
                    android:id="@+id/themeOled"
                    style="@style/Segment"
                    android:text="@string/theme_oled" />

                <Button
                    android:id="@+id/themeDark"
                    style="@style/Segment"
                    android:layout_marginHorizontal="6dp"
                    android:text="@string/theme_dark" />

                <Button
                    android:id="@+id/themeLight"
                    style="@style/Segment"
                    android:text="@string/theme_light" />
            </LinearLayout>

            <!-- Accent lamps, filled in by MainActivity -->
            <LinearLayout
                android:id="@+id/accentRow"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:orientation="horizontal" />
        </LinearLayout>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="16dp"
            android:gravity="center"
            android:text="@string/background_hint"
            android:textColor="?attr/pmMuted"
            android:textSize="11sp" />

    </LinearLayout>
</ScrollView>
