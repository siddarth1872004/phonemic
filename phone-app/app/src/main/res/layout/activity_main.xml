<?xml version="1.0" encoding="utf-8"?>
<!-- Framework widgets only (no AppCompat / Material): a small, fast APK. -->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?attr/pmBg"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingHorizontal="20dp"
        android:paddingVertical="24dp">

        <!-- Header -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:layout_marginBottom="28dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:background="@drawable/bg_disc"
                android:contentDescription="@null"
                android:padding="10dp"
                android:src="@drawable/ic_mic"
                android:tint="?attr/pmOnAccent" />

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="14dp"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="sans-serif-medium"
                    android:text="@string/app_name"
                    android:textColor="?attr/pmText"
                    android:textSize="24sp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/tagline"
                    android:textColor="?attr/pmMuted"
                    android:textSize="13sp" />
            </LinearLayout>
        </LinearLayout>

        <!-- PC + link status -->
        <LinearLayout style="@style/Card">

            <TextView
                style="@style/Label"
                android:text="@string/pc_label" />

            <!-- Bluetooth / Wi-Fi / USB -->
            <LinearLayout
                android:id="@+id/linkRow"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:orientation="horizontal">

                <Button
                    android:id="@+id/linkBluetooth"
                    style="@style/Segment"
                    android:text="@string/link_bluetooth" />

                <Button
                    android:id="@+id/linkWifi"
                    style="@style/Segment"
                    android:layout_marginHorizontal="6dp"
                    android:text="@string/link_wifi" />

                <Button
                    android:id="@+id/linkUsb"
                    style="@style/Segment"
                    android:text="@string/link_usb" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/pcRow"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:background="?android:attr/selectableItemBackground"
                android:gravity="center_vertical"
                android:minHeight="48dp"
                android:orientation="horizontal">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/pcName"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:ellipsize="end"
                        android:fontFamily="sans-serif-medium"
                        android:maxLines="1"
                        android:text="@string/choose_pc"
                        android:textColor="?attr/pmText"
                        android:textSize="20sp" />

                    <TextView
                        android:id="@+id/pcHint"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/pc_hint_choose"
                        android:textColor="?attr/pmMuted"
                        android:textSize="12sp" />
                </LinearLayout>

                <ImageView
                    android:id="@+id/pcChevron"
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:contentDescription="@string/choose_pc"
                    android:src="@drawable/ic_chevron"
                    android:tint="?attr/pmMuted" />
            </LinearLayout>

            <!-- Wi-Fi only: the PIN set in PhoneMic on the PC (if any). -->
            <LinearLayout
                android:id="@+id/pinRow"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="?android:attr/selectableItemBackground"
                android:gravity="center_vertical"
                android:minHeight="44dp"
                android:orientation="horizontal"
                android:visibility="gone">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/pin_label"
                    android:textColor="?attr/pmText"
                    android:textSize="15sp" />

                <TextView
                    android:id="@+id/pinValue"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/pin_none"
                    android:textColor="?attr/pmMuted"
                    android:textSize="14sp" />
            </LinearLayout>

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginVertical="16dp"
                android:background="?attr/pmEdge" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <View
                    android:id="@+id/statusDot"
                    android:layout_width="8dp"
                    android:layout_height="8dp"
                    android:layout_marginEnd="10dp"
                    android:background="@drawable/dot"
                    android:backgroundTint="?attr/pmMuted" />

                <TextView
                    android:id="@+id/statusText"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/status_idle"
                    android:textColor="?attr/pmMuted"
                    android:textSize="14sp" />
            </LinearLayout>

            <ProgressBar
                android:id="@+id/levelBar"
                style="?android:attr/progressBarStyleHorizontal"
                android:layout_width="match_parent"
                android:layout_height="8dp"
                android:layout_marginTop="14dp"
                android:max="100"
                android:progress="0"
                android:progressDrawable="@drawable/meter" />

            <TextView
                android:id="@+id/statsText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:fontFeatureSettings="tnum"
                android:textColor="?attr/pmMuted"
                android:textSize="11sp" />
        </LinearLayout>

        <!-- Voice -->
        <LinearLayout
            style="@style/Card"
            android:layout_marginTop="12dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginEnd="12dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="sans-serif-medium"
                    android:text="@string/voice_focus"
                    android:textColor="?attr/pmText"
                    android:textSize="16sp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/voice_focus_desc"
                    android:textColor="?attr/pmMuted"
                    android:textSize="13sp" />
            </LinearLayout>

            <Switch
                android:id="@+id/voiceFocusSwitch"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:checked="true"
                android:switchMinWidth="48dp"
                android:thumb="@drawable/switch_thumb"
                android:thumbTint="@color/switch_thumb_tint"
                android:track="@drawable/switch_track"
                android:trackTint="@color/switch_track_tint" />
        </LinearLayout>

        <!-- Appearance: theme + accent, same choices as the desktop app -->
        <LinearLayout
            style="@style/Card"
            android:layout_marginTop="12dp">

            <TextView
                style="@style/Label"
                android:text="@string/appearance_label" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:orientation="horizontal">

                <Button
                    android:id="@+id/themeOled"
                    style="@style/Segment"
                    android:text="@string/theme_oled" />

                <Button
                    android:id="@+id/themeDark"
                    style="@style/Segment"
                    android:layout_marginHorizontal="6dp"
                    android:text="@string/theme_dark" />

                <Button
                    android:id="@+id/themeLight"
                    style="@style/Segment"
                    android:text="@string/theme_light" />
            </LinearLayout>

            <!-- Accent swatches, filled in by MainActivity -->
            <LinearLayout
                android:id="@+id/accentRow"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:orientation="horizontal" />
        </LinearLayout>

        <!-- Start / Stop -->
        <Button
            android:id="@+id/toggleButton"
            style="@style/Pill"
            android:layout_height="58dp"
            android:layout_marginTop="24dp"
            android:backgroundTint="?attr/pmAccent"
            android:text="@string/start"
            android:textColor="?attr/pmOnAccent"
            android:textSize="17sp" />

        <Button
            android:id="@+id/muteButton"
            style="@style/Pill"
            android:layout_height="50dp"
            android:layout_marginTop="10dp"
            android:backgroundTint="?attr/pmControl"
            android:text="@string/mute"
            android:textColor="?attr/pmText"
            android:textSize="15sp"
            android:visibility="gone" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="18dp"
            android:gravity="center"
            android:text="@string/background_hint"
            android:textColor="?attr/pmMuted"
            android:textSize="12sp" />

        <TextView
            android:id="@+id/versionText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="6dp"
            android:alpha="0.6"
            android:textColor="?attr/pmMuted"
            android:textSize="11sp" />

    </LinearLayout>
</ScrollView>
