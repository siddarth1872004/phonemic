<?xml version="1.0" encoding="utf-8"?>
<!-- A raised key cap: shadow under, cap with a hairline edge and top bevel. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:top="2dp">
        <shape android:shape="rectangle">
            <solid android:color="#66000000" />
            <corners android:radius="6dp" />
        </shape>
    </item>
    <item android:bottom="2dp">
        <shape android:shape="rectangle">
            <solid android:color="?attr/pmControl" />
            <stroke android:width="1dp" android:color="?attr/pmEdge" />
            <corners android:radius="6dp" />
        </shape>
    </item>
    <item android:left="6dp" android:right="6dp" android:top="1dp" android:gravity="top" android:height="1dp">
        <shape android:shape="rectangle">
            <solid android:color="#1AFFFFFF" />
        </shape>
    </item>
</layer-list>
