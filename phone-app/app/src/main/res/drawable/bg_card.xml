<?xml version="1.0" encoding="utf-8"?>
<!-- A rack faceplate: hairline edge, faint top bevel, four corner screws. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <solid android:color="?attr/pmCard" />
            <stroke android:width="1dp" android:color="?attr/pmEdge" />
            <corners android:radius="8dp" />
        </shape>
    </item>
    <item android:left="8dp" android:right="8dp" android:top="1dp" android:gravity="top" android:height="1dp">
        <shape android:shape="rectangle">
            <solid android:color="#14FFFFFF" />
        </shape>
    </item>
    <item android:drawable="@drawable/screw" android:gravity="top|start" android:left="6dp" android:top="6dp" />
    <item android:drawable="@drawable/screw" android:gravity="top|end" android:right="6dp" android:top="6dp" />
    <item android:drawable="@drawable/screw" android:gravity="bottom|start" android:left="6dp" android:bottom="6dp" />
    <item android:drawable="@drawable/screw" android:gravity="bottom|end" android:right="6dp" android:bottom="6dp" />
</layer-list>
