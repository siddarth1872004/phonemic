<?xml version="1.0" encoding="utf-8"?>
<!-- Framework themes only: no AppCompat / Material Components in the APK.
     Same palettes as the desktop app (pc-app/gui/ui.cpp). MainActivity picks a
     theme from the settings, then lays an Accent.* overlay on top.
     Studio-hardware look: graphite faceplates, LED lamps, and one hot signal
     colour (the accent) that means "live". -->
<resources>
    <!-- Black: true #000 so an OLED panel keeps its pixels off. -->
    <style name="Theme.PhoneMic" parent="android:Theme.Material.NoActionBar">
        <item name="pmBg">#FF000000</item>
        <item name="pmCard">#FF0E0E10</item>
        <item name="pmEdge">#FF222226</item>
        <item name="pmControl">#FF18181B</item>
        <item name="pmControlHover">#FF232327</item>
        <item name="pmLedOff">#FF26262B</item>
        <item name="pmText">#FFEEEEF0</item>
        <item name="pmMuted">#FF7E7E86</item>
        <item name="pmGreen">#FF3DDC84</item>
        <item name="pmAmber">#FFFFB020</item>
        <item name="pmRed">#FFFF4D4D</item>
        <item name="pmAccent">#FFFF6B1A</item>
        <item name="pmOnAccent">#FF000000</item>
        <item name="android:colorBackground">?attr/pmBg</item>
        <item name="android:colorAccent">?attr/pmAccent</item>
        <item name="android:colorControlActivated">?attr/pmAccent</item>
        <item name="android:textColorPrimary">?attr/pmText</item>
        <item name="android:textColorSecondary">?attr/pmMuted</item>
        <item name="android:textColorHint">?attr/pmMuted</item>
        <item name="android:windowBackground">?attr/pmBg</item>
        <item name="android:statusBarColor">?attr/pmBg</item>
        <item name="android:navigationBarColor">?attr/pmBg</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowLightNavigationBar">false</item>
        <item name="android:alertDialogTheme">@style/Theme.PhoneMic.Dialog</item>
    </style>

    <style name="Theme.PhoneMic.Dark">
        <item name="pmBg">#FF161618</item>
        <item name="pmCard">#FF1F1F22</item>
        <item name="pmEdge">#FF313136</item>
        <item name="pmControl">#FF2A2A2E</item>
        <item name="pmControlHover">#FF35353A</item>
        <item name="pmLedOff">#FF34343A</item>
        <item name="pmMuted">#FF909098</item>
    </style>

    <style name="Theme.PhoneMic.Light" parent="android:Theme.Material.Light.NoActionBar">
        <item name="pmBg">#FFD8D9DC</item>
        <item name="pmCard">#FFECEDEF</item>
        <item name="pmEdge">#FFBFC1C6</item>
        <item name="pmControl">#FFDFE0E3</item>
        <item name="pmControlHover">#FFD1D3D7</item>
        <item name="pmLedOff">#FFC6C8CC</item>
        <item name="pmText">#FF191A1D</item>
        <item name="pmMuted">#FF5C5E66</item>
        <item name="pmGreen">#FF1F9D57</item>
        <item name="pmAmber">#FFB86E00</item>
        <item name="pmRed">#FFD63B3B</item>
        <item name="pmAccent">#FFD9500B</item>
        <item name="pmOnAccent">#FFFFFFFF</item>
        <item name="android:colorBackground">?attr/pmBg</item>
        <item name="android:colorAccent">?attr/pmAccent</item>
        <item name="android:colorControlActivated">?attr/pmAccent</item>
        <item name="android:textColorPrimary">?attr/pmText</item>
        <item name="android:textColorSecondary">?attr/pmMuted</item>
        <item name="android:textColorHint">?attr/pmMuted</item>
        <item name="android:windowBackground">?attr/pmBg</item>
        <item name="android:statusBarColor">?attr/pmBg</item>
        <item name="android:navigationBarColor">?attr/pmBg</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:windowLightNavigationBar">true</item>
        <item name="android:alertDialogTheme">@style/Theme.PhoneMic.Dialog.Light</item>
    </style>

    <style name="Theme.PhoneMic.Dialog" parent="android:Theme.Material.Dialog.Alert">
        <item name="android:colorBackground">?attr/pmCard</item>
        <item name="android:colorAccent">?attr/pmAccent</item>
        <item name="android:colorControlActivated">?attr/pmAccent</item>
        <item name="android:textColorPrimary">?attr/pmText</item>
        <item name="android:textColorSecondary">?attr/pmMuted</item>
    </style>

    <style name="Theme.PhoneMic.Dialog.Light" parent="android:Theme.Material.Light.Dialog.Alert">
        <item name="android:colorBackground">?attr/pmCard</item>
        <item name="android:colorAccent">?attr/pmAccent</item>
        <item name="android:colorControlActivated">?attr/pmAccent</item>
        <item name="android:textColorPrimary">?attr/pmText</item>
        <item name="android:textColorSecondary">?attr/pmMuted</item>
    </style>

    <!-- Accents: a bright shade for the dark themes, a deeper one that reads on white. -->
    <style name="Accent" />
    <style name="Accent.Signal"><item name="pmAccent">#FFFF6B1A</item></style>
    <style name="Accent.Teal"><item name="pmAccent">#FF2FD1C0</item></style>
    <style name="Accent.Violet"><item name="pmAccent">#FFB48CFF</item></style>
    <style name="Accent.Rose"><item name="pmAccent">#FFFF5C93</item></style>
    <style name="Accent.Ice"><item name="pmAccent">#FF6FA8FF</item></style>
    <style name="Accent.Signal.Light"><item name="pmAccent">#FFD9500B</item></style>
    <style name="Accent.Teal.Light"><item name="pmAccent">#FF0B8F82</item></style>
    <style name="Accent.Violet.Light"><item name="pmAccent">#FF7A4FD9</item></style>
    <style name="Accent.Rose.Light"><item name="pmAccent">#FFD23F73</item></style>
    <style name="Accent.Ice.Light"><item name="pmAccent">#FF2F6BD6</item></style>

    <!-- Silkscreened panel legend: small, monospace, letter-spaced caps. -->
    <style name="Label">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:letterSpacing">0.22</item>
        <item name="android:textColor">?attr/pmMuted</item>
        <item name="android:textSize">10sp</item>
        <item name="android:fontFamily">monospace</item>
        <item name="android:textAllCaps">true</item>
    </style>

    <style name="Card">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:background">@drawable/bg_card</item>
        <item name="android:orientation">vertical</item>
        <item name="android:paddingHorizontal">20dp</item>
        <item name="android:paddingTop">14dp</item>
        <item name="android:paddingBottom">18dp</item>
    </style>

    <style name="Pill">
        <item name="android:layout_width">match_parent</item>
        <item name="android:background">@drawable/bg_pill</item>
        <item name="android:foreground">?android:attr/selectableItemBackground</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:gravity">center</item>
        <item name="android:stateListAnimator">@null</item>
        <item name="android:textAllCaps">false</item>
    </style>

    <!-- A hardware key: raised cap with a lamp. [Keys] lights it. -->
    <style name="Key">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">48dp</item>
        <item name="android:layout_weight">1</item>
        <item name="android:background">@drawable/bg_key</item>
        <item name="android:foreground">?android:attr/selectableItemBackground</item>
        <item name="android:drawableStart">@drawable/led</item>
        <item name="android:drawablePadding">8dp</item>
        <item name="android:paddingHorizontal">12dp</item>
        <item name="android:paddingBottom">3dp</item>
        <item name="android:fontFamily">monospace</item>
        <item name="android:textStyle">bold</item>
        <item name="android:letterSpacing">0.12</item>
        <item name="android:textSize">12sp</item>
        <item name="android:textColor">?attr/pmText</item>
        <item name="android:gravity">center</item>
        <item name="android:stateListAnimator">@null</item>
        <item name="android:textAllCaps">true</item>
        <item name="android:maxLines">1</item>
    </style>

    <!-- One segment of a segmented choice (link, theme). -->
    <style name="Segment" parent="Key">
        <item name="android:layout_height">42dp</item>
        <item name="android:textSize">11sp</item>
    </style>

    <!-- A readout window: legend over a monospace value. -->
    <style name="Readout">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_weight">1</item>
        <item name="android:background">@drawable/bg_readout</item>
        <item name="android:paddingHorizontal">8dp</item>
        <item name="android:paddingVertical">6dp</item>
        <item name="android:fontFamily">monospace</item>
        <item name="android:textSize">13sp</item>
        <item name="android:textColor">?attr/pmText</item>
        <item name="android:lineSpacingExtra">2dp</item>
        <item name="android:maxLines">2</item>
    </style>
</resources>
