# cmake -DOUT=<file.cpp> -DDIR=<dir> -DFILES=a;b -P EmbedFiles.cmake
# Generates a C++ table of {path, mime, bytes} for the built-in web server.
string(REPLACE "," ";" FILES "${FILES}")
set(_src "// Generated by cmake/EmbedFiles.cmake — do not edit.\n#include <cstddef>\n#include <cstdint>\n\nnamespace phonemic::web_assets {\n")
set(_table "")
set(_i 0)
foreach(f ${FILES})
  file(READ ${DIR}/${f} _hex HEX)
  string(LENGTH "${_hex}" _hexlen)
  math(EXPR _len "${_hexlen} / 2")
  string(REGEX REPLACE "([0-9a-f][0-9a-f])" "0x\\1," _bytes "${_hex}")
  string(APPEND _src "static const uint8_t f${_i}[] = {${_bytes}0};\n")
  if(f MATCHES "\\.html$")
    set(_mime "text/html; charset=utf-8")
  elseif(f MATCHES "\\.js$")
    set(_mime "text/javascript; charset=utf-8")
  elseif(f MATCHES "\\.css$")
    set(_mime "text/css; charset=utf-8")
  else()
    set(_mime "application/octet-stream")
  endif()
  string(APPEND _table "  {\"/${f}\", \"${_mime}\", f${_i}, ${_len}},\n")
  math(EXPR _i "${_i} + 1")
endforeach()
string(APPEND _src "\nstruct Asset { const char* path; const char* mime; const uint8_t* data; size_t size; };\n")
string(APPEND _src "extern const Asset kAssets[] = {\n${_table}  {nullptr, nullptr, nullptr, 0}};\n}  // namespace phonemic::web_assets\n")
file(WRITE ${OUT}.tmp "${_src}")
file(COPY_FILE ${OUT}.tmp ${OUT} ONLY_IF_DIFFERENT)
