// Windows resources for PhoneMic.exe: the icon and the version.
#include <winver.h>

// Explorer shows it for the .exe; GLFW picks up a resource named GLFW_ICON as
// the window and taskbar icon. Regenerate with packaging/make-icons.sh.
GLFW_ICON ICON "phonemic.ico"

VS_VERSION_INFO VERSIONINFO
 FILEVERSION 0,4,1,0
 PRODUCTVERSION 0,4,1,0
 FILEOS VOS_NT_WINDOWS32
 FILETYPE VFT_APP
BEGIN
  BLOCK "StringFileInfo"
  BEGIN
    BLOCK "040904b0"
    BEGIN
      VALUE "CompanyName", "PhoneMic Project"
      VALUE "FileDescription", "PhoneMic - use your phone as a microphone"
      VALUE "FileVersion", "0.4.1"
      VALUE "InternalName", "PhoneMic"
      VALUE "LegalCopyright", "MIT OR Apache-2.0"
      VALUE "OriginalFilename", "PhoneMic.exe"
      VALUE "ProductName", "PhoneMic"
      VALUE "ProductVersion", "0.4.1"
    END
  END
  BLOCK "VarFileInfo"
  BEGIN
    VALUE "Translation", 0x409, 1200
  END
END
