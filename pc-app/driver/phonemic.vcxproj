<?xml version="1.0" encoding="utf-8"?>
<!--
  PhoneMic virtual audio capture driver (KMDF + ACX).

  Requires the Windows Driver Kit (WDK) and its Visual Studio extension. If this
  project file drifts from your WDK version, the reliable fallback is: File >
  New > Project > "Kernel Mode Driver, Empty (KMDF)", then add driver.c,
  driver.h, and phonemic.inf and set the same properties shown below.
-->
<Project DefaultTargets="Build" ToolsVersion="15.0" xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <ItemGroup Label="ProjectConfigurations">
    <ProjectConfiguration Include="Debug|x64">
      <Configuration>Debug</Configuration>
      <Platform>x64</Platform>
    </ProjectConfiguration>
    <ProjectConfiguration Include="Release|x64">
      <Configuration>Release</Configuration>
      <Platform>x64</Platform>
    </ProjectConfiguration>
  </ItemGroup>

  <PropertyGroup Label="Globals">
    <ProjectGuid>{B1C0A2D3-4E5F-6071-8293-A4B5C6D7E8F9}</ProjectGuid>
    <RootNamespace>phonemic</RootNamespace>
    <MinimumVisualStudioVersion>15.0</MinimumVisualStudioVersion>
    <Configuration>Debug</Configuration>
    <Platform Condition="'$(Platform)' == ''">x64</Platform>
    <TargetVersion>Windows10</TargetVersion>
    <DriverType>KMDF</DriverType>
  </PropertyGroup>

  <Import Project="$(VCTargetsPath)\Microsoft.Cpp.Default.props" />

  <PropertyGroup Label="Configuration">
    <ConfigurationType>Driver</ConfigurationType>
    <DriverType>KMDF</DriverType>
    <PlatformToolset>WindowsKernelModeDriver10.0</PlatformToolset>
  </PropertyGroup>

  <Import Project="$(VCTargetsPath)\Microsoft.Cpp.props" />

  <PropertyGroup>
    <EnableInf2cat>true</EnableInf2cat>
    <!-- ACX (Audio Class eXtensions) 1.0 on KMDF 1.33: the WDK targets add the
         ACX headers and import library when these are set. ACX needs Windows 11. -->
    <KMDF_VERSION_MAJOR>1</KMDF_VERSION_MAJOR>
    <KMDF_VERSION_MINOR>33</KMDF_VERSION_MINOR>
    <ACX_VERSION_MAJOR>1</ACX_VERSION_MAJOR>
    <ACX_VERSION_MINOR>0</ACX_VERSION_MINOR>
    <TargetVersion>Windows10</TargetVersion>
  </PropertyGroup>

  <ItemDefinitionGroup>
    <ClCompile>
      <WarningLevel>Level4</WarningLevel>
      <TreatWarningAsError>true</TreatWarningAsError>
      <PreprocessorDefinitions>POOL_ZERO_DOWN_LEVEL_SUPPORT;%(PreprocessorDefinitions)</PreprocessorDefinitions>
    </ClCompile>
    <Link>
      <AdditionalDependencies>$(DDK_LIB_PATH)ksguid.lib;%(AdditionalDependencies)</AdditionalDependencies>
    </Link>
  </ItemDefinitionGroup>

  <!-- Some WDK installs (e.g. GitHub's windows-2022 image) lack the ACX headers.
       Point PhonemicAcxRoot at the "c" folder of the Microsoft.Windows.WDK.x64
       NuGet package to take ACX from there (CI does). -->
  <PropertyGroup>
    <PhonemicAcxSdkVersion Condition="'$(PhonemicAcxSdkVersion)' == ''">10.0.26100.0</PhonemicAcxSdkVersion>
  </PropertyGroup>
  <ItemDefinitionGroup Condition="'$(PhonemicAcxRoot)' != ''">
    <ClCompile>
      <!-- ACX needs KMDF headers from the same WDK (older ones lack WDF_STRUCT_INFO). -->
      <AdditionalIncludeDirectories>$(PhonemicAcxRoot)\Include\$(PhonemicAcxSdkVersion)\km\acx\km\$(ACX_VERSION_MAJOR).$(ACX_VERSION_MINOR);$(PhonemicAcxRoot)\Include\wdf\kmdf\$(KMDF_VERSION_MAJOR).$(KMDF_VERSION_MINOR);%(AdditionalIncludeDirectories)</AdditionalIncludeDirectories>
      <!-- A WDK without ACX support doesn't define these for us. -->
      <PreprocessorDefinitions>ACX_VERSION_MAJOR=$(ACX_VERSION_MAJOR);ACX_VERSION_MINOR=$(ACX_VERSION_MINOR);%(PreprocessorDefinitions)</PreprocessorDefinitions>
    </ClCompile>
    <Link>
      <AdditionalDependencies>$(PhonemicAcxRoot)\Lib\$(PhonemicAcxSdkVersion)\km\x64\acx\km\$(ACX_VERSION_MAJOR).$(ACX_VERSION_MINOR)\acxstub.lib;%(AdditionalDependencies)</AdditionalDependencies>
    </Link>
  </ItemDefinitionGroup>

  <ItemGroup>
    <ClCompile Include="driver.c" />
  </ItemGroup>
  <ItemGroup>
    <ClInclude Include="driver.h" />
    <ClInclude Include="..\ipc\ring.h" />
  </ItemGroup>
  <ItemGroup>
    <!-- PhonemicSkipInf=true builds just phonemic.sys (CI: the runner image's
         InfVerif.dll is missing, and packaging needs signing anyway). -->
    <Inf Include="phonemic.inf" Condition="'$(PhonemicSkipInf)' != 'true'" />
  </ItemGroup>

  <Import Project="$(VCTargetsPath)\Microsoft.Cpp.targets" />
</Project>
