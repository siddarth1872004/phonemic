;
; phonemic.inf — PhoneMic virtual audio capture driver (ACX), EXPERIMENTAL.
;
; Installs a root-enumerated ACX audio device exposing one capture endpoint
; ("PhoneMic Microphone"). Requires test-signing during development (README.md).
;

[Version]
Signature   = "$WINDOWS NT$"
Class       = MEDIA
ClassGuid   = {4d36e96c-e325-11ce-bfc1-08002be10318}
Provider    = %ManufacturerName%
CatalogFile = phonemic.cat
DriverVer   = ; set by stampinf during the build
PnpLockdown = 1

[Manufacturer]
%ManufacturerName% = Standard,NTamd64.10.0...22000

[Standard.NTamd64.10.0...22000]
%Phonemic.DeviceDesc% = Phonemic_Install, Root\PhonemicCapture

[SourceDisksNames]
1 = %DiskName%

[SourceDisksFiles]
phonemic.sys = 1

[DestinationDirs]
DefaultDestDir = 13 ; DIRID_DRIVER_STORE

[Phonemic_Install.NT]
Include   = ks.inf, wdmaudio.inf
Needs     = KS.Registration, WDMAUDIO.Registration
CopyFiles = Phonemic_CopyFiles

[Phonemic_CopyFiles]
phonemic.sys

[Phonemic_Install.NT.Services]
Include = wdmaudio.inf
Needs   = WDMAUDIO.Registration.Services
AddService = phonemic, 0x00000002, Phonemic_Service

[Phonemic_Service]
DisplayName   = %Phonemic.SvcDesc%
ServiceType   = 1 ; SERVICE_KERNEL_DRIVER
StartType     = 3 ; SERVICE_DEMAND_START
ErrorControl  = 1 ; SERVICE_ERROR_NORMAL
ServiceBinary = %13%\phonemic.sys

[Phonemic_Install.NT.Wdf]
KmdfService = phonemic, Phonemic_wdfsect

[Phonemic_wdfsect]
KmdfLibraryVersion = $KMDFVERSION$

[Strings]
ManufacturerName    = "PhoneMic Project"
DiskName            = "PhoneMic Installation Disk"
Phonemic.DeviceDesc = "PhoneMic Microphone (virtual)"
Phonemic.SvcDesc    = "PhoneMic virtual microphone driver"
